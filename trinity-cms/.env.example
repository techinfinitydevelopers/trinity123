# --- required ---
DATABASE_URL="postgresql://trinity:trinity@localhost:5433/trinity_cms"   # local: npm run db:dev · prod: Neon / Vercel Postgres
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"                              # prod: https://www.trinitystudyabroad.com

# --- chatbot ---
ANTHROPIC_API_KEY=""               # enables meaning-based (semantic) FAQ matching; keyword matching works without it
RESEND_API_KEY=""                  # enables the "urgent query" email alert to admins — https://resend.com/api-keys
RESEND_FROM="Trinity Chatbot <onboarding@resend.dev>"   # verify your own domain in Resend before using a custom address

# --- production only ---
BLOB_READ_WRITE_TOKEN=""          # Vercel Blob — image uploads (local dev writes to public/uploads)

# --- seed overrides (optional) ---
ADMIN_EMAIL="admin@trinitystudyabroad.com"
ADMIN_PASSWORD="set-a-strong-password-before-seeding-production"
